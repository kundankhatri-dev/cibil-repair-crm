# ============================================
# 🔥 COMPLETE .HTACCESS - CIBIL REPAIR CRM
# ============================================

RewriteEngine On
RewriteBase /

# ============================================
# 🔥 FORCE HTTPS & WWW TO NON-WWW
# ============================================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.cibilrepair\.in$ [NC]
RewriteRule ^(.*)$ https://cibilrepair.in/$1 [R=301,L]

# ============================================
# 🔥 API CONFIGURATION - FIXED
# ============================================

# API exemption - skip rewrite rules for API (MUST BE FIRST)
RewriteRule ^api/ - [L,NC]

# Handle API OPTIONS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^api/.*$ - [R=200,L]

# ============================================
# 🔥 REFERRAL SHORT LINK REDIRECT
# ============================================
RewriteRule ^r/([A-Za-z0-9-]+)$ /?ref=$1 [R=301,L]

# ============================================
# 🔥 HOME PAGE ALIAS
# ============================================
RewriteRule ^home$ / [L,R=301]

# ============================================
# 🔥 DASHBOARD ROUTES (FIXED)
# ============================================
RewriteRule ^login$ login.php [L,NC]
RewriteRule ^logout$ logout.php [L,NC]
RewriteRule ^admin$ admin-dashboard.php [L,NC]
RewriteRule ^admin-dashboard$ admin-dashboard.php [L,NC]
RewriteRule ^employee-dashboard$ employee-dashboard.php [L,NC]
RewriteRule ^ceo-dashboard$ ceo-dashboard.php [L,NC]
RewriteRule ^hr-dashboard$ hr-dashboard.php [L,NC]
RewriteRule ^finance-dashboard$ finance-dashboard.php [L,NC]
RewriteRule ^sales-dashboard$ sales-dashboard.php [L,NC]
RewriteRule ^legal-dashboard$ legal-dashboard.php [L,NC]
RewriteRule ^partner-dashboard$ partner-dashboard.php [L,NC]
RewriteRule ^client-dashboard$ client-dashboard.php [L,NC]

# ============================================
# 🔥 SMART URL REWRITING
# ============================================

# Check if clean URL maps to a PHP file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Check if clean URL maps to an HTML file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ============================================
# 🔥 REMOVE .PHP EXTENSION FROM URLS (EXCEPT API)
# ============================================
RewriteCond %{THE_REQUEST} \.php [NC]
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|pdf|zip|json|xml)$ [NC]
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# ============================================
# 🔥 SITEMAP ROUTES
# ============================================
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
RewriteRule ^sitemap-index\.xml$ sitemap.php [L,NC]

# ============================================
# 🔥 EXEMPT FILES
# ============================================
RewriteRule ^robots\.txt$ - [L,NC]
RewriteRule ^favicon\.ico$ - [L,NC]

# ============================================
# 🔥 CORS HEADERS FOR API (FIXED)
# ============================================
<IfModule mod_headers.c>
    <FilesMatch "\.(php|phtml)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, X-CSRF-Token, Authorization, X-Requested-With"
        Header set Access-Control-Allow-Credentials "true"
        Header set Access-Control-Max-Age "86400"
    </FilesMatch>
</IfModule>

# ============================================
# 🔥 CACHING RULES
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain text/xml
</IfModule>

# ============================================
# 🔥 SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ============================================
# 🔥 PROTECT SENSITIVE FILES
# ============================================
<FilesMatch "\.(ini|log|sql|bak|config|env|gitignore|htaccess-bak|lock|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

<Files "composer.json">
    Order Allow,Deny
    Deny from all
</Files>

<Files "composer.lock">
    Order Allow,Deny
    Deny from all
</Files>

# ============================================
# 🔥 PROTECT SENSITIVE DIRECTORIES
# ============================================
RewriteRule ^data/ - [F,L]
RewriteRule ^temp/ - [F,L]
RewriteRule ^backups/ - [F,L]
RewriteRule ^logs/ - [F,L]

# ============================================
# 🔥 BLOCK PHP EXECUTION IN SENSITIVE DIRECTORIES
# ============================================
<DirectoryMatch "^.*/(uploads|data|temp|backups|logs)/">
    <FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|sh)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</DirectoryMatch>

RewriteCond %{REQUEST_URI} ^/(uploads|data|temp|backups|logs)/.*\.(php|phtml|php3|php4|php5|phps)$ [NC]
RewriteRule .* - [F,L]

# ============================================
# 🔥 PREVENT HOTLINKING
# ============================================
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?cibilrepair\.in [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico)$ - [F,L]

# ============================================
# 🔥 BLOCK COMMON ATTACK PATTERNS
# ============================================
RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%00|%0a|%0d) [NC,OR]
RewriteCond %{QUERY_STRING} (eval\(|base64_|system\(|passthru\(|exec\(|shell_exec\(|popen\() [NC,OR]
RewriteCond %{QUERY_STRING} (SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE) [NC,OR]
RewriteCond %{QUERY_STRING} (UNION|DECLARE|CAST|EXEC|XP_) [NC]
RewriteRule .* - [F,L]

# ============================================
# 🔥 DISABLE DIRECTORY LISTING
# ============================================
Options -Indexes

# ============================================
# 🔥 CUSTOM ERROR PAGES
# ============================================
ErrorDocument 404 /error/404.html
ErrorDocument 403 /error/403.html
ErrorDocument 500 /error/500.html
ErrorDocument 502 /error/502.html
ErrorDocument 503 /error/503.html

# ============================================
# 🔥 END OF .HTACCESS
# ============================================