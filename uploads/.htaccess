# Prevent direct access to uploaded files
Options -Indexes
Order Deny,Allow
Deny from all

# Only allow access to specific file types if needed
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect against script execution
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    Deny from all
</FilesMatch>